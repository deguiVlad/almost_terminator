<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>arm_ik</name>
  <version>1.0.0</version>
  <description>
    Обратная кинематика обеих рук TienKung 2.0 Pro (7 DOF на руку): цепочка суставов из URDF
    в /robot_description, DLS-IK с пределами суставов и несколькими стартами, команды в /arm/cmd_pos
    и дотягивание по /joint_states.
  </description>
  <maintainer email="dev@example.com">hackathon team</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>bodyctrl_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
