# Запрос IK: цель PoseStamped в рамке pelvis + выбор руки
geometry_msgs/PoseStamped goal
string side                 # "left" | "right"
bool use_zero_seed          # стартовать IK из нуля, а не из текущих суставов
---
bool success
string[] joint_names
float64[] positions         # решённые углы, рад (в пределах URDF)
uint8[] motor_ids           # ID моторов для /arm/cmd_pos
float64 final_error         # нормированная ошибка позы после решения
