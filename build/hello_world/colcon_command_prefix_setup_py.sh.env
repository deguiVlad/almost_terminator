ACCEPT_EULA=Y
AMENT_PREFIX_PATH=/opt/ros/humble
CMAKE_PREFIX_PATH=/opt/ros/humble
COLCON=1
DEBIAN_FRONTEND=noninteractive
DISPLAY=
DOCKER_USER_HOME=/root
FASTRTPS_DEFAULT_PROFILES_FILE=/nssr_sim/hackathon/docker/fastdds_hack.xml
HOME=/root
HOSTNAME=rentserver
ISAACLAB_PATH=/workspace/isaaclab
ISAACSIM_ROOT_PATH=/isaac-sim
ISAACSIM_VERSION=
LANG=C.UTF-8
LD_LIBRARY_PATH=/opt/ros/humble/lib/x86_64-linux-gnu:/opt/ros/humble/lib
MIN_DRIVER_VERSION=535.129.03
NVIDIA_DRIVER_CAPABILITIES=all
NVIDIA_VISIBLE_DEVICES=all
OLDPWD=/nssr_sim
OMNI_SERVER=https://omniverse-content-production.s3-us-west-2.amazonaws.com/Assets/Isaac/5.0
PATH=/opt/ros/humble/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
PRIVACY_CONSENT=Y
PWD=/nssr_sim/hackathon/ros2/build/hello_world
PYTHONPATH=/opt/ros/humble/lib/python3.10/site-packages:/opt/ros/humble/local/lib/python3.10/dist-packages
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
ROS_DISTRO=humble
ROS_DOMAIN_ID=146
ROS_LOCALHOST_ONLY=0
ROS_PYTHON_VERSION=3
ROS_VERSION=2
SHLVL=1
TERM=xterm
VK_DRIVER_FILES=/etc/vulkan/icd.d/nvidia_icd.json
_=/usr/bin/colcon
