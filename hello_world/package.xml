<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>hello_world</name>
  <version>1.0.0</version>
  <description>Starter package for the nssr-polygon manipulation track: reads joints, the head camera and the task, turns the head and opens/closes the right hand.</description>
  <maintainer email="nssr.nikolay@gmail.com">Nikolay Semenov</maintainer>
  <author email="nssr.nikolay@gmail.com">Nikolay Semenov</author>
  <license>Apache-2.0</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>bodyctrl_msgs</exec_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
